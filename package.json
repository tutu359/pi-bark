{
	"name": "pi-bark",
	"version": "0.9.0",
	"description": "Bark notifications and response sharing for Pi.",
	"keywords": [
		"pi-package",
		"pi",
		"bark",
		"ios",
		"notification"
	],
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"license": "MIT",
	"files": [
		"LICENSE",
		"dist",
		"extensions",
		"src",
		"README.md"
	],
	"bin": {
		"pi-bark-key": "./dist/scripts/generate-encryption-key.js"
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"check": "biome check .",
		"check:write": "biome check --write .",
		"test": "pnpm run build && node --test test/*.test.ts",
		"typecheck": "tsc --noEmit --project tsconfig.json",
		"prepack": "pnpm run build",
		"pack:check": "pnpm pack --dry-run",
		"key": "pnpm run build && node dist/scripts/generate-encryption-key.js"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "^1.3.0",
		"typebox": "*"
	},
	"pi": {
		"extensions": [
			"./extensions/bark.ts"
		]
	},
	"dependencies": {
		"proper-lockfile": "^4.1.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@types/node": "26.6.6",
		"@types/proper-lockfile": "4.1.4",
		"typebox": "1.3.27",
		"typescript": "6.0.3"
	},
	"private": true,
	"overrides": {
		"protobufjs": "7.6.6"
	},
	"packageManager": "pnpm@12.16.1"
}
